# Copia este archivo a .env y ajusta los valores según tu entorno.
# Para docker compose, DATABASE_URL usa el host "db"; para venv local, "localhost".

DATABASE_URL=postgresql+psycopg://prestamos:prestamos@localhost:5432/prestamos
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
